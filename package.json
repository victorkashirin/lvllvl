    "check": "node --check playwright.config.mjs && node --check scripts/browser-policy.mjs && node --check scripts/build-graph.mjs && node --check scripts/build.mjs && node --check scripts/dependency-inventory.mjs && node --check scripts/dev.mjs && node --check scripts/module-boundaries.mjs && node --check scripts/verify-build.mjs && node --check src/js/bootstrap.mjs && node --check src/js/modules/featureRegistry.mjs && node --check src/js/modules/imageImportFeature.mjs && node --check tests/browser-support.spec.mjs && node --check tests/build-system.test.mjs && node --check tests/feature-loading.spec.mjs && node --check tests/module-architecture.test.mjs",
    "browsers": "browserslist",
    "dependencies:check": "node scripts/dependency-inventory.mjs --check",
    "dependencies:update": "node scripts/dependency-inventory.mjs --write",
    "audit:dependencies": "npm audit --omit=dev",
    "artifacts:update": "npm run build && node scripts/verify-build.mjs --update-golden",
    "test": "npm run build && npm run test:source && npm run test:build && npm run test:e2e",
    "test:source": "node --test tests/*.test.mjs",
    "test:build": "npm run dependencies:check && node scripts/verify-build.mjs",
    "test:e2e": "playwright test"
  },
  "browserslist": [
    "last 1 Chrome version",
    "last 1 Edge version",
    "last 1 Firefox version",
    "last 1 Safari version",
    "last 1 iOS version",
    "last 1 ChromeAndroid version"
  ],
